---
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
<div class="faq">
  {faqs.map((f, i) => (
    <details open={i === 0}>
      <summary><span>{f.q}</span><span class="icon" aria-hidden="true"></span></summary>
      <div class="a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 10px; }
  details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); transition: box-shadow 0.25s var(--ease), border-color 0.25s; }
  details[open] { box-shadow: var(--shadow-sm); border-color: var(--line-strong); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 22px 24px; font-family: var(--serif); font-size: clamp(1.25rem, 1.9vw, 1.5rem); line-height: 1.25; color: var(--green-900);
  }
  summary::-webkit-details-marker { display: none; }
  .icon { position: relative; flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--mint); }
  .icon::before, .icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: var(--green-800); transform: translate(-50%, -50%); transition: transform 0.3s var(--ease); }
  .icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .a { padding: 0 72px 24px 24px; color: var(--ink-2); font-size: 1.04rem; max-width: 780px; }
  @media (max-width: 600px) { .a { padding-right: 24px; } }
</style>
