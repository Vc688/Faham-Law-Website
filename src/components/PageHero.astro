---
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: { name: string; href?: string }[]; compact?: boolean }
const { eyebrow, title, lead, crumbs = [], compact = false } = Astro.props;
---
<section class:list={['hero', 'page-hero', { compact }]}>
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            {i < crumbs.length - 1 && <span aria-hidden="true">/</span>}
          </>
        ))}
      </nav>
    )}
    <div class="ph">
      <div class="ph-main">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="display" set:html={title} />
      </div>
      {(lead || Astro.slots.has('default')) && (
        <div class="ph-side">
          {lead && <p class="lead">{lead}</p>}
          <slot />
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .ph { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: end; padding-bottom: clamp(36px, 5vw, 56px); border-bottom: 1px solid var(--line-strong); }
  .ph-main { display: grid; gap: 22px; }
  .ph-side { display: grid; gap: 24px; padding-bottom: 6px; }
  .compact .display { font-size: clamp(2.6rem, 5.6vw, 4.8rem); }
  @media (max-width: 900px) { .ph { grid-template-columns: 1fr; align-items: start; } }
</style>
