---
import Logo from './Logo.astro';
import { firm, practices, settings } from '../data/site';
interface Props { showInsights: boolean }
const { showInsights } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isPractice = path === '/services' || practices.some((p) => path === `/${p.slug}`);
const links = [
  { href: '/about', label: 'About' },
  { href: '/fees', label: 'Fees' },
  ...(showInsights ? [{ href: '/insights', label: 'Insights' }] : []),
  { href: '/contact', label: 'Contact' },
];
const cta = settings.headerCta;
---
<header class="site-header" data-header>
  <div class="container bar">
    <Logo size="sm" />

    <nav class="nav" aria-label="Main">
      <ul role="list">
        <li class="has-menu" data-menu>
          <button class:list={['nav-link', { current: isPractice }]} aria-expanded="false" aria-controls="practice-menu" data-menu-btn>
            Practice Areas
            <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" /></svg>
          </button>
          <div class="menu" id="practice-menu" data-menu-panel>
            <div class="menu-inner">
              <ul role="list" class="menu-list">
                {practices.map((p, i) => (
                  <li>
                    <a href={`/${p.slug}`} aria-current={path === `/${p.slug}` ? 'page' : undefined}>
                      <span class="num serif">{i + 1}</span>
                      <span class="menu-copy">
                        <span class="menu-name">{p.name}</span>
                        <span class="menu-sum">{p.seoTitle.split('|')[0].trim()}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <div class="menu-foot">
                <a class="link-arrow" href="/services">All practice areas <span class="arrow" aria-hidden="true">→</span></a>
                <a class="menu-tm" href="/file-a-trademark">File a Trademark <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </li>
        {links.map((l) => (
          <li><a class:list={['nav-link', { current: path.startsWith(l.href) }]} href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={firm.phoneHref}>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M5 3h3.5l1.8 4.6-2.3 1.5a11 11 0 0 0 6.9 6.9l1.5-2.3L21 15.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>
        {firm.phone}
      </a>
      <a class="btn btn-sm btn-ghost login" href="/admin" rel="nofollow">Log in</a>
      <a class="btn btn-sm cta" href={cta.href}>{cta.label}</a>
      <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-nav" data-mobile hidden>
    <div class="container mobile-inner">
      <p class="eyebrow">Practice Areas</p>
      <ul role="list" class="m-practices">
        {practices.map((p, i) => <li><a href={`/${p.slug}`}><span class="m-num">{i + 1}</span>{p.name}</a></li>)}
        <li><a href="/services" class="m-all">All practice areas →</a></li>
      </ul>
      <ul role="list" class="m-links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/file-a-trademark">File a Trademark</a></li>
        <li><a href="/admin" rel="nofollow">Log in</a></li>
      </ul>
      <div class="m-contact">
        <a class="btn" href={cta.href}>{cta.label}</a>
        <a class="btn btn-ghost" href={firm.phoneHref}>Call {firm.phone}</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Practice dropdown
  const item = header.querySelector<HTMLElement>('[data-menu]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  let closeTimer: number | undefined;
  const setOpen = (open: boolean) => {
    item.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(!item.classList.contains('open')));
  item.addEventListener('mouseenter', () => { if (matchMedia('(hover:hover)').matches) { clearTimeout(closeTimer); setOpen(true); } });
  item.addEventListener('mouseleave', () => { if (matchMedia('(hover:hover)').matches) closeTimer = window.setTimeout(() => setOpen(false), 160); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setOpen(false); toggleMobile(false); } });
  document.addEventListener('click', (e) => { if (!item.contains(e.target as Node)) setOpen(false); });

  // Mobile
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mobile = header.querySelector<HTMLElement>('[data-mobile]')!;
  function toggleMobile(open: boolean) {
    mobile.hidden = !open;
    header.classList.toggle('mobile-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }
  burger.addEventListener('click', () => toggleMobile(mobile.hidden));
</script>

<style>
  /* Solid bar, a shade lighter than the page, with a rule underneath. */
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: #fdfcf9; border-bottom: 1px solid var(--line-strong);
    transition: box-shadow 0.3s var(--ease);
  }
  .site-header.is-scrolled { box-shadow: 0 6px 24px -18px rgba(20, 34, 30, 0.35); }
  .bar { height: calc(var(--header-h) - 1px); display: flex; align-items: center; gap: 20px; }

  .nav { margin-inline: auto; }
  .nav > ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 16px; border-radius: 999px;
    background: none; border: 0; color: var(--ink-2); cursor: pointer;
    font-size: 0.96rem; font-weight: 480; text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .nav-link:hover { color: var(--green-800); background: var(--mint-2); }
  .nav-link.current { color: var(--green-800); background: var(--mint); }
  .has-menu { position: relative; }
  .has-menu.open .nav-link svg { transform: rotate(180deg); }
  .nav-link svg { transition: transform 0.25s var(--ease); }

  .menu {
    position: absolute; left: 50%; top: calc(100% + 14px); width: min(640px, 90vw);
    transform: translate(-50%, -6px);
    opacity: 0; visibility: hidden;
    transition: opacity 0.22s var(--ease), transform 0.22s var(--ease), visibility 0.22s;
  }
  .menu::before { content: ''; position: absolute; inset: -14px 0 auto; height: 14px; }
  .has-menu.open .menu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .menu-inner {
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line-strong); border-radius: var(--radius-md); box-shadow: var(--shadow);
    padding: 10px;
  }
  .menu-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .menu-list a { display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: start; padding: 14px 16px; border-radius: 10px; text-decoration: none; transition: background 0.2s; }
  .menu-list a:hover, .menu-list a[aria-current] { background: var(--surface-warm); box-shadow: inset 0 0 0 1px var(--line); }
  .num { font-size: 1.5rem; line-height: 1; color: var(--brass); }
  .menu-copy { display: grid; gap: 3px; }
  .menu-name { font-weight: 540; color: var(--green-900); }
  .menu-sum { font-size: 0.82rem; line-height: 1.35; color: var(--muted); }
  .menu-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 6px; padding: 14px 16px 8px; border-top: 1px solid var(--line); }
  .menu-tm { font-size: 0.9rem; font-weight: 540; color: var(--brass); text-decoration: none; }
  .menu-tm:hover { text-decoration: underline; }

  .actions { display: flex; align-items: center; gap: 10px; }
  .phone { display: inline-flex; align-items: center; gap: 8px; margin-right: 6px; text-decoration: none; font-size: 0.95rem; font-weight: 500; color: var(--green-800); white-space: nowrap; }
  .phone:hover { color: var(--green-700); }

  .burger { display: none; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--surface); color: var(--green-900); cursor: pointer; position: relative; }
  .burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease), top 0.3s var(--ease); }
  .burger span:first-child { top: 17px; }
  .burger span:last-child { top: 25px; }
  .mobile-open .burger span:first-child { top: 21px; transform: rotate(45deg); }
  .mobile-open .burger span:last-child { top: 21px; transform: rotate(-45deg); }

  .mobile { position: fixed; inset: var(--header-h) 0 0 0; background: var(--paper); overflow-y: auto; }
  .mobile-inner { padding-top: 24px; padding-bottom: 40px; display: grid; gap: 22px; }
  .mobile ul { list-style: none; margin: 0; padding: 0; }
  .m-practices a { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; font-family: var(--serif); font-size: 1.7rem; line-height: 1.15; color: var(--green-900); text-decoration: none; border-bottom: 1px solid var(--line); }
  .m-num { font-size: 1rem; color: var(--brass); width: 16px; }
  .m-practices .m-all { font-family: var(--sans); font-size: 0.95rem; font-weight: 540; color: var(--green-700); border: 0; padding-top: 14px; }
  .m-links a { display: block; padding: 12px 0; font-weight: 500; font-size: 1.1rem; text-decoration: none; border-bottom: 1px solid var(--line); }
  .m-contact { display: grid; gap: 10px; margin-top: 8px; }

  @media (max-width: 1280px) { .phone { display: none; } }
  @media (max-width: 1040px) {
    .nav, .cta, .login { display: none; }
    .burger { display: inline-block; }
    .actions { margin-left: auto; }
  }
</style>
