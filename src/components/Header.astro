---
import Logo from './Logo.astro';
import { firm, practices } from '../data/site';
interface Props { showInsights: boolean }
const { showInsights } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isPractice = path === '/services' || practices.some((p) => path === `/${p.slug}`);
const links = [
  { href: '/about', label: 'About' },
  ...(showInsights ? [{ href: '/insights', label: 'Insights' }] : []),
  { href: '/contact', label: 'Contact' },
];
---
<header class="site-header" data-header>
  <div class="container bar">
    <Logo size="sm" />

    <nav class="nav" aria-label="Main">
      <ul role="list">
        <li class="has-menu" data-menu>
          <button class:list={['nav-link', { current: isPractice }]} aria-expanded="false" aria-controls="practice-menu" data-menu-btn>
            Practice Areas
            <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" /></svg>
          </button>
          <div class="menu" id="practice-menu" data-menu-panel>
            <div class="menu-inner">
              <div class="menu-intro">
                <p class="eyebrow">Practice Areas</p>
                <p class="menu-title serif">Counsel for companies at every stage.</p>
                <a class="link-arrow" href="/services">All practice areas <span class="arrow" aria-hidden="true">→</span></a>
              </div>
              <ul role="list" class="menu-list">
                {practices.map((p, i) => (
                  <li>
                    <a href={`/${p.slug}`} aria-current={path === `/${p.slug}` ? 'page' : undefined}>
                      <span class="num">0{i + 1}</span>
                      <span class="menu-name">{p.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
        {links.map((l) => (
          <li><a class:list={['nav-link', { current: path.startsWith(l.href) }]} href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={firm.phoneHref}>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M5 3h3.5l1.8 4.6-2.3 1.5a11 11 0 0 0 6.9 6.9l1.5-2.3L21 15.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>
        {firm.phone}
      </a>
      <a class="btn btn-sm cta" href="/file-a-trademark">File a Trademark</a>
      <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-nav" data-mobile hidden>
    <div class="container mobile-inner">
      <p class="eyebrow">Practice Areas</p>
      <ul role="list" class="m-practices">
        {practices.map((p) => <li><a href={`/${p.slug}`}>{p.name}</a></li>)}
        <li><a href="/services" class="m-all">All practice areas →</a></li>
      </ul>
      <ul role="list" class="m-links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/file-a-trademark">File a Trademark</a></li>
      </ul>
      <div class="m-contact">
        <a class="btn btn-brass" href={firm.phoneHref}>Call {firm.phone}</a>
        <a class="btn btn-ghost" href={`mailto:${firm.email}`}>{firm.email}</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Practice dropdown
  const item = header.querySelector<HTMLElement>('[data-menu]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  let closeTimer: number | undefined;
  const setOpen = (open: boolean) => {
    item.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(!item.classList.contains('open')));
  item.addEventListener('mouseenter', () => { if (matchMedia('(hover:hover)').matches) { clearTimeout(closeTimer); setOpen(true); } });
  item.addEventListener('mouseleave', () => { if (matchMedia('(hover:hover)').matches) closeTimer = window.setTimeout(() => setOpen(false), 160); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setOpen(false); toggleMobile(false); } });
  document.addEventListener('click', (e) => { if (!item.contains(e.target as Node)) setOpen(false); });

  // Mobile
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mobile = header.querySelector<HTMLElement>('[data-mobile]')!;
  function toggleMobile(open: boolean) {
    mobile.hidden = !open;
    header.classList.toggle('mobile-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }
  burger.addEventListener('click', () => toggleMobile(mobile.hidden));
</script>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    color: #fff;
    transition: background 0.35s var(--ease), color 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-solid, .site-header.mobile-open {
    background: rgba(246, 244, 239, 0.86);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    color: var(--ink);
    border-bottom-color: var(--line);
  }
  .site-header.mobile-open { background: var(--paper); }
  .site-header:not(.is-solid):not(.mobile-open) :global(.faham) { color: #fff; }
  .site-header:not(.is-solid):not(.mobile-open) :global(.law) { color: rgba(255,255,255,0.62); }
  .site-header:not(.is-solid):not(.mobile-open) :global(.mark-f) { fill: #fff; }
  .site-header:not(.is-solid):not(.mobile-open) :global(.mark-box) { stroke: rgba(255,255,255,0.45); }

  .bar { height: var(--header-h); display: flex; align-items: center; gap: 24px; }
  .nav { margin-left: auto; }
  .nav > ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 14px; border-radius: 999px;
    background: none; border: 0; color: inherit; cursor: pointer;
    font-size: 0.93rem; font-weight: 500; text-decoration: none; opacity: 0.88;
    transition: opacity 0.2s, background 0.2s;
  }
  .nav-link:hover, .nav-link.current { opacity: 1; background: color-mix(in srgb, currentColor 9%, transparent); }
  .has-menu { position: relative; }
  .has-menu.open .nav-link svg { transform: rotate(180deg); }
  .nav-link svg { transition: transform 0.25s var(--ease); }

  .menu {
    position: fixed; left: 0; right: 0; top: var(--header-h);
    padding: 12px var(--gutter) 0;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
  }
  .has-menu.open .menu { opacity: 1; visibility: visible; transform: none; }
  .menu-inner {
    max-width: calc(var(--max) - 2 * var(--gutter)); margin-inline: auto;
    display: grid; grid-template-columns: 1fr 1.6fr; gap: 40px;
    background: var(--white); color: var(--ink);
    border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow);
    padding: 32px;
  }
  .menu-intro { display: grid; align-content: start; gap: 14px; padding-right: 24px; border-right: 1px solid var(--line); }
  .menu-title { font-size: 1.8rem; line-height: 1.1; }
  .menu-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; }
  .menu-list a { display: flex; gap: 14px; align-items: baseline; padding: 14px 14px; border-radius: 12px; text-decoration: none; transition: background 0.2s; }
  .menu-list a:hover, .menu-list a[aria-current] { background: var(--paper); }
  .num { font-size: 0.75rem; color: var(--green-700); font-weight: 600; letter-spacing: 0.08em; }
  .menu-name { font-weight: 550; }

  .actions { display: flex; align-items: center; gap: 16px; }
  .phone { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-size: 0.92rem; font-weight: 500; opacity: 0.9; white-space: nowrap; }
  .phone:hover { opacity: 1; }
  .btn-sm { min-height: 42px; padding: 0 18px; font-size: 0.88rem; }
  .site-header:not(.is-solid) .cta { --bg: var(--paper); --fg: var(--green-900); }
  .site-header:not(.is-solid) .cta:hover { background: #fff; }

  .burger { display: none; width: 44px; height: 44px; border-radius: 50%; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); background: none; color: inherit; cursor: pointer; position: relative; }
  .burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease), top 0.3s var(--ease); }
  .burger span:first-child { top: 17px; }
  .burger span:last-child { top: 25px; }
  .mobile-open .burger span:first-child { top: 21px; transform: rotate(45deg); }
  .mobile-open .burger span:last-child { top: 21px; transform: rotate(-45deg); }

  .mobile { position: fixed; inset: var(--header-h) 0 0 0; background: var(--paper); overflow-y: auto; }
  .mobile-inner { padding-top: 28px; padding-bottom: 40px; display: grid; gap: 22px; }
  .mobile ul { list-style: none; margin: 0; padding: 0; }
  .m-practices a { display: block; padding: 10px 0; font-family: var(--serif); font-size: 1.85rem; line-height: 1.15; text-decoration: none; border-bottom: 1px solid var(--line); }
  .m-practices .m-all { font-family: var(--sans); font-size: 0.95rem; font-weight: 600; color: var(--green-700); border: 0; padding-top: 14px; }
  .m-links a { display: block; padding: 12px 0; font-weight: 550; font-size: 1.1rem; text-decoration: none; border-bottom: 1px solid var(--line); }
  .m-contact { display: grid; gap: 12px; margin-top: 8px; }

  @media (max-width: 1080px) {
    .phone { display: none; }
  }
  @media (max-width: 900px) {
    .nav, .cta { display: none; }
    .burger { display: inline-block; }
    .actions { margin-left: auto; }
  }
</style>
