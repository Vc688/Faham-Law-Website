---
// The firm's actual logo artwork (public/images/logo*.png), generated from the brand file.
//   logo.png          mark + "FAHAM LAW"            (light backgrounds)
//   logo-tagline.png  same, with "Experience. Diligence. Results."
//   logo-light.png    white version                  (dark backgrounds)
interface Props { tone?: 'light' | 'dark'; size?: 'sm' | 'md' | 'lg'; tagline?: boolean; href?: string | null }
const { tone = 'dark', size = 'md', tagline = false, href = '/' } = Astro.props;
const Tag = href ? 'a' : 'span';
const withTagline = tagline && tone === 'dark';
const src = tone === 'light' ? '/images/logo-light.png' : withTagline ? '/images/logo-tagline.png' : '/images/logo.png';
const [w, h] = withTagline ? [1323, 460] : [1323, 353];
---
<Tag href={href ?? undefined} class:list={['logo', `logo-${size}`, { 'logo-tagline': withTagline }]} aria-label={href ? 'Faham Law LLC, home' : undefined}>
  <img src={src} alt={href ? '' : 'Faham Law LLC'} width={w} height={h} decoding="async" />
</Tag>
<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; line-height: 0; --h: 48px; }
  .logo-sm { --h: 38px; }
  .logo-lg { --h: 64px; }
  .logo-tagline { --h: calc(var(--h) * 1.3); }
  .logo img { height: var(--h); width: auto; }
</style>
