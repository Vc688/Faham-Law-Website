---
import { firm } from '../data/site';
interface Props { title?: string; text?: string; secondary?: { label: string; href: string } }
const { title = 'Let’s talk about your business.', text = 'Tell us about your matter and we’ll call you back to schedule a consultation.', secondary } = Astro.props;
---
<section class="cta-band">
  <div class="container">
    <div class="inner reveal">
      <div class="copy">
        <p class="eyebrow">Book a consultation</p>
        <h2 class="h2">{title}</h2>
        <p class="txt">{text}</p>
      </div>
      <div class="side">
        <div class="btns">
          <a class="btn btn-brass" href="/contact">Book a consultation <span class="arrow" aria-hidden="true">→</span></a>
          {secondary ? <a class="btn btn-ghost on-dark" href={secondary.href}>{secondary.label}</a> : <a class="btn btn-ghost on-dark" href={firm.phoneHref}>Call {firm.phone}</a>}
        </div>
        <p class="mail">Or email <a href={`mailto:${firm.email}`}>{firm.email}</a></p>
      </div>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(56px, 8vw, 104px); }
  .inner {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: end;
    background: var(--green-800); color: #e8f0ec;
    border-radius: clamp(24px, 3vw, 36px); padding: clamp(32px, 6vw, 72px);
    box-shadow: var(--shadow);
  }
  .inner::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(60% 120% at 100% 0%, rgba(233, 220, 193, 0.2), transparent 60%),
      radial-gradient(50% 90% at 0% 100%, rgba(159, 196, 183, 0.16), transparent 70%);
  }
  .eyebrow { color: var(--brass-soft); }
  .copy { display: grid; gap: 16px; max-width: 680px; }
  .h2 { color: #f4f1e8; font-size: clamp(1.9rem, 3.6vw, 3rem); }
  .txt { color: rgba(232, 240, 236, 0.78); font-size: 1.08rem; }
  .side { display: grid; gap: 16px; justify-items: end; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
  .mail { font-size: 0.9rem; color: rgba(232, 240, 236, 0.66); }
  .mail a { color: #fff; }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; align-items: start; } .side, .btns { justify-items: start; justify-content: flex-start; } }
</style>
