---
import { firm } from '../data/site';
interface Props { title?: string; text?: string; secondary?: { label: string; href: string } }
const { title = 'Let’s talk about your business.', text = 'Tell us about your matter and we’ll call you back to schedule a consultation.', secondary } = Astro.props;
---
<section class="cta-band">
  <div class="container">
    <div class="inner reveal">
      <div class="copy">
        <h2 class="h2">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btns">
        <a class="btn btn-brass" href="/contact">Book a consultation <span class="arrow" aria-hidden="true">→</span></a>
        {secondary ? <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a> : <a class="btn btn-ghost" href={firm.phoneHref}>Call {firm.phone}</a>}
      </div>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(56px, 8vw, 104px); }
  .inner {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1.4fr auto; gap: 32px; align-items: end;
    background: var(--green-800); color: #eef4f1;
    border-radius: 28px; padding: clamp(36px, 6vw, 72px);
    isolation: isolate;
  }
  .inner::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(60% 120% at 100% 0%, rgba(194, 163, 107, 0.28), transparent 60%);
  }
  .copy { display: grid; gap: 14px; max-width: 640px; }
  .copy p { color: rgba(238, 244, 241, 0.78); font-size: 1.08rem; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-ghost { border-color: rgba(255,255,255,0.3); color: #fff; }
  .btn-ghost:hover { background: rgba(255,255,255,0.08); }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; align-items: start; } }
</style>
