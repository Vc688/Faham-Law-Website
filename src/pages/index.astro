---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import PostCard from '../components/PostCard.astro';
import { firm, practices, industries, testimonials, showTestimonials, practiceBySlug } from '../data/site';
import { getPublishedPosts } from '../lib/posts';
import { davidPerson } from '../lib/schema';

const posts = (await getPublishedPosts()).slice(0, 3);
const years = new Date().getFullYear() - firm.since;

// "Where is your business today?" routes a visitor to the right practice page.
const stages = [
  { need: 'Starting a business', slug: 'startups-small-business' },
  { need: 'Growing without an in-house lawyer', slug: 'corporate-counsel' },
  { need: 'Buying or selling a business', slug: 'mergers-acquisitions' },
  { need: 'Buying, selling or leasing property', slug: 'real-estate' },
  { need: 'Protecting a brand name or logo', slug: 'ip-trademarks' },
];

const ip = practiceBySlug['ip-trademarks'];
const ipFaq = (q: string) => ip.faqs.find((f) => f.q.startsWith(q))?.a ?? '';
const tmSteps = [
  { n: '01', title: 'Search', text: ip.groups[0].items[0].text },
  { n: '02', title: 'File', text: ip.groups[0].items[1].text },
  { n: '03', title: 'Examination', text: ipFaq('How long') },
  { n: '04', title: 'Maintain & renew', text: ipFaq('When do I need') },
];
const [featured, ...moreTestimonials] = testimonials;
---
<Base
  title="Faham Law LLC | Business, Real Estate & IP Attorney in NY & NJ"
  description="Faham Law LLC advises businesses of every size in New York, New Jersey and Pennsylvania on entity formation, contracts, M&A, real estate and trademarks."
  jsonld={[davidPerson]}
>
  <!-- HERO -->
  <section class="hero home-hero">
    <div class="container">
      <div class="hero-top">
        <p class="eyebrow">Boutique business law firm · Since {firm.since}</p>
        <p class="kicker">New York, NY · Oakhurst, NJ</p>
      </div>
      <h1 class="display hero-title">Business, Real Estate &amp; IP Counsel for Companies at <em>Every Stage</em></h1>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lead">From forming your company and filing your first trademark to closings, contracts and acquisitions.</p>
          <div class="hero-btns">
            <a class="btn" href="/contact">Book a consultation <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={firm.phoneHref}>Call {firm.phone}</a>
          </div>
          <p class="licensed"><span class="pill">NY · NJ · PA</span> {firm.licensed}</p>
        </div>

        <nav class="stage-card" aria-label="Find the right practice area">
          <p class="stage-title serif">Where is your business today?</p>
          <ol role="list">
            {stages.map((s) => (
              <li>
                <a href={`/${s.slug}`}>
                  <span class="s-need">{s.need}</span>
                  <span class="s-area">{practiceBySlug[s.slug].name}</span>
                  <span class="s-go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  </section>

  <!-- LEDGER -->
  <section class="ledger-sec" aria-label="Firm at a glance">
    <div class="container">
      <dl class="ledger">
        <div><dt>Established</dt><dd class="serif">{firm.since}</dd></div>
        <div><dt>Licensed in</dt><dd>New York · New Jersey · Pennsylvania</dd></div>
        <div><dt>Offices</dt><dd>New York, NY &amp; Oakhurst, NJ</dd></div>
        <div><dt>Partner</dt><dd>David Faham, J.D., Fordham Law</dd></div>
      </dl>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section intro">
    <div class="container intro-grid">
      <p class="eyebrow reveal">The firm</p>
      <div class="intro-copy reveal">
        <p class="statement serif">Faham Law LLC is a boutique business law firm with offices in New York and New Jersey. Since {firm.since}, we have advised companies at every stage, from founders forming their first business to established companies buying, selling and growing.</p>
        <div class="facts">
          <div><span class="serif n">{years}+</span><span>years advising businesses</span></div>
          <div><span class="serif n">3</span><span>state bar admissions: NY, NJ &amp; PA</span></div>
          <div><span class="serif n">5</span><span>practice areas under one roof</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRACTICE AREAS -->
  <section class="section-tight practices-sec" id="practice-areas">
    <div class="container">
      <div class="split-head reveal">
        <div class="section-head">
          <p class="eyebrow">How we help</p>
          <h2 class="h2">Five practice areas, <em>one point of contact.</em></h2>
        </div>
        <a class="link-arrow" href="/services">All practice areas <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="bento">
        {practices.map((p, i) => (
          <a href={`/${p.slug}`} class:list={['p-card reveal', { feature: p.slug === 'ip-trademarks' }]}>
            <span class="p-num serif">{i + 1}</span>
            <h3 class="p-name serif">{p.name}</h3>
            <p class="p-sum">{p.short}</p>
            <span class="p-foot">
              <span class="link-arrow">Learn more <span class="arrow" aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
      <div class="industries reveal" aria-label="Industries we serve">
        <span class="kicker">Industries we serve</span>
        <ul role="list">{industries.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- TRADEMARK PATH -->
  <section class="section tm-sec dark">
    <div class="container tm-grid">
      <div class="tm-copy reveal">
        <p class="eyebrow">IP &amp; Trademarks</p>
        <h2 class="h2">Protect your brand <em>before someone else claims it.</em></h2>
        <p class="lead">{ip.intro}</p>
        <div class="tm-btns">
          <a class="btn btn-brass" href="/file-a-trademark">File a Trademark <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost on-dark" href="/ip-trademarks">Trademark services</a>
        </div>

        <div class="specimen" aria-hidden="true">
          <div class="spec-head"><span>Trademark application</span><span class="spec-pill">In progress</span></div>
          <div class="spec-mark serif">YOUR BRAND</div>
          <div class="spec-rows">
            <span>Owner</span><span>Your Company LLC</span>
            <span>Goods &amp; services</span><span>What you sell under the mark</span>
            <span>First use</span><span>MM/DD/YYYY</span>
          </div>
          <div class="spec-track"><i class="on"></i><i class="on"></i><i></i><i></i></div>
        </div>
      </div>

      <ol class="tm-steps" role="list">
        {tmSteps.map((s) => (
          <li class="reveal">
            <span class="tm-n serif">{s.n}</span>
            <div>
              <h3 class="tm-title">{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section approach">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Working with us</p>
        <h2 class="h2">Straightforward <em>from the first call.</em></h2>
      </div>
      <ol class="steps" role="list">
        <li class="reveal">
          <span class="step-n serif">i.</span>
          <h3 class="h3">Tell us about your matter</h3>
          <p>Use the form, email or call. Describe the issue you're facing first, then what you want to achieve.</p>
        </li>
        <li class="reveal">
          <span class="step-n serif">ii.</span>
          <h3 class="h3">We call you back</h3>
          <p>We'll reach out to schedule a consultation at a time that works for you. Office hours are on demand.</p>
        </li>
        <li class="reveal">
          <span class="step-n serif">iii.</span>
          <h3 class="h3">A fee structure that fits</h3>
          <p>We offer various payment and fee structures, and we only work for as long as a matter requires.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ABOUT DAVID -->
  <section class="section-tight about-teaser">
    <div class="container">
      <div class="at-card reveal">
        <div class="portrait">
          <img src="/images/david-faham.jpg" alt="David Faham, partner at Faham Law LLC" width="500" height="750" loading="lazy" decoding="async" />
        </div>
        <div class="at-copy">
          <p class="eyebrow">Meet the partner</p>
          <h2 class="h2">David Faham</h2>
          <p class="lead">A born-and-raised New Yorker, David has advised businesses of every size since {firm.since}. Having served as general counsel for companies large and small, he brings an in-house perspective to outside counsel work: practical advice that fits how a business actually runs.</p>
          <ul class="creds" role="list">
            <li><span>J.D., Intellectual Property</span><span>Fordham University School of Law</span></li>
            <li><span>B.S., Business Management &amp; Finance, Economics</span><span>Brooklyn College, CUNY</span></li>
            <li><span>Bar admissions</span><span>New York · New Jersey · Pennsylvania</span></li>
          </ul>
          <a class="link-arrow" href="/about">Read David's bio <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {showTestimonials && (
    <section class="section-tight testi">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Client perspectives</p>
          <h2 class="h2">In their words.</h2>
        </div>
        <div class="t-grid">
          <figure class="t-feature reveal">
            <blockquote class="serif">“{featured.quote}”</blockquote>
            <figcaption><strong>{featured.name}</strong><span>{featured.role}</span></figcaption>
          </figure>
          <div class="t-stack">
            {moreTestimonials.map((t) => (
              <figure class="t-card reveal">
                <blockquote class="serif">“{t.quote}”</blockquote>
                <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
        <p class="t-note">Prior results do not guarantee a similar outcome. <a href="/testimonials">All testimonials</a></p>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <div class="split-head reveal">
          <div class="section-head">
            <p class="eyebrow">Insights</p>
            <h2 class="h2">Notes for business owners.</h2>
          </div>
          <a class="link-arrow" href="/insights">All insights <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="posts-grid">
          {posts.map((post) => <div class="reveal"><PostCard post={post} /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section class="section contact-sec" id="contact">
    <div class="container c-grid">
      <div class="c-copy reveal">
        <p class="eyebrow">Book a consultation</p>
        <h2 class="h2">Tell us what you're <em>working on.</em></h2>
        <p class="lead">We'll call you back to schedule an appointment. You may also email or call us directly.</p>
        <dl class="c-list">
          <div><dt>Phone</dt><dd><a href={firm.phoneHref}>{firm.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${firm.email}`}>{firm.email}</a></dd></div>
          <div><dt>Offices</dt><dd>New York, NY · Oakhurst, NJ</dd></div>
        </dl>
      </div>
      <div class="c-form card reveal">
        <ContactForm idPrefix="home" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .home-hero { padding-bottom: clamp(40px, 5vw, 64px); }
  .hero-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 36px); }
  .hero-title { max-width: 14.5em; font-size: clamp(2.7rem, 7.4vw, 6.8rem); }
  .hero-grid {
    display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(32px, 6vw, 96px); align-items: start;
    margin-top: clamp(36px, 5vw, 64px); padding-top: clamp(28px, 4vw, 40px); border-top: 1px solid var(--line-strong);
  }
  .hero-copy { display: grid; gap: 26px; }
  .hero-copy .lead { max-width: 500px; font-size: clamp(1.15rem, 1.6vw, 1.4rem); }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .licensed { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 0.9rem; color: var(--muted); }

  .stage-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 10px; }
  .stage-title { font-size: 1.45rem; color: var(--green-900); padding: 16px 18px 12px; }
  .stage-card ol { list-style: none; margin: 0; padding: 0; }
  .stage-card li + li { border-top: 1px solid var(--line); }
  .stage-card a {
    display: grid; grid-template-columns: 1fr auto 28px; align-items: center; gap: 14px;
    padding: 15px 18px; border-radius: 14px; text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .stage-card li:hover + li, .stage-card li:hover { border-color: transparent; }
  .stage-card a:hover { background: var(--green-800); color: #fff; }
  .s-need { font-weight: 480; font-size: 1.02rem; }
  .s-area { font-size: 0.78rem; font-weight: 540; letter-spacing: 0.04em; color: var(--green-700); background: var(--mint); padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
  .stage-card a:hover .s-area { background: rgba(255,255,255,0.14); color: var(--brass-soft); }
  .s-go { color: var(--brass); transition: transform 0.25s var(--ease); }
  .stage-card a:hover .s-go { transform: translateX(3px); color: var(--brass-soft); }

  /* Ledger */
  .ledger { margin: 0; display: grid; grid-template-columns: 0.7fr 1.3fr 1.1fr 1.2fr; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }
  .ledger > div { padding: 22px 26px; display: grid; gap: 6px; align-content: start; }
  .ledger > div + div { border-left: 1px solid var(--line); }
  .ledger dt { font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); font-weight: 560; }
  .ledger dd { margin: 0; color: var(--green-900); font-weight: 480; }
  .ledger dd.serif { font-size: 2rem; line-height: 1; font-weight: 400; }

  /* Intro */
  .intro-grid { display: grid; grid-template-columns: 1fr 3fr; gap: 40px; }
  .intro-copy { display: grid; gap: 56px; }
  .statement { font-size: clamp(1.7rem, 3.2vw, 2.7rem); line-height: 1.24; letter-spacing: -0.015em; color: var(--green-900); }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; border-top: 1px solid var(--line-strong); padding-top: 30px; }
  .facts > div { display: grid; gap: 6px; }
  .facts .n { font-size: clamp(2.8rem, 5vw, 4.2rem); line-height: 1; color: var(--green-700); font-style: italic; }
  .facts span:last-child { color: var(--muted); font-size: 0.96rem; }

  /* Practice bento */
  .practices-sec { padding-top: 0; }
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .p-card {
    display: grid; grid-template-rows: auto auto 1fr auto; gap: 14px;
    padding: clamp(24px, 2.6vw, 34px); min-height: 330px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow-sm); text-decoration: none;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s;
  }
  .p-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--line-strong); }
  .p-card:hover .arrow { transform: translateX(3px); }
  .p-num { font-size: 2.4rem; line-height: 1; font-style: italic; color: var(--brass); }
  .p-name { font-size: clamp(1.7rem, 2.4vw, 2.2rem); line-height: 1.05; color: var(--green-900); letter-spacing: -0.015em; }
  .p-sum { color: var(--muted); font-size: 0.98rem; }
  .p-foot { padding-top: 8px; }
  .feature { grid-column: span 2; background: var(--green-800); border-color: transparent; color: #e8f0ec; position: relative; overflow: hidden; isolation: isolate; }
  .feature::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(70% 90% at 100% 0%, rgba(233, 220, 193, 0.2), transparent 60%); }
  .feature .p-name { color: #f4f1e8; font-size: clamp(2rem, 3.2vw, 2.9rem); }
  .feature .p-sum { color: rgba(232, 240, 236, 0.78); max-width: 520px; font-size: 1.05rem; }
  .feature .p-num { color: var(--brass-soft); }
  .feature .link-arrow { color: var(--brass-soft); }
  .industries { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 28px; padding: 18px 22px; border: 1px dashed var(--line-strong); border-radius: var(--radius-md); }
  .industries ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .industries li { padding: 6px 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 0.88rem; color: var(--ink-2); }

  /* Trademark path */
  .tm-sec { position: relative; overflow: hidden; isolation: isolate; border-radius: clamp(24px, 3vw, 40px); margin-inline: clamp(8px, 1.4vw, 20px); }
  .tm-sec::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(800px 420px at 100% 0%, rgba(158, 196, 198, 0.18), transparent 65%), radial-gradient(700px 400px at 0% 100%, rgba(168, 131, 74, 0.16), transparent 65%); }
  .tm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .tm-copy { display: grid; gap: 24px; position: sticky; top: calc(var(--header-h) + 24px); }
  .tm-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .specimen { --line: #e4ddcf; margin-top: 12px; background: #fbf9f3; color: var(--ink); border-radius: var(--radius); padding: 22px 24px; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5); transform: rotate(-1.2deg); max-width: 440px; }
  .spec-head { display: flex; justify-content: space-between; align-items: center; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); font-weight: 560; }
  .spec-pill { background: var(--brass-wash); color: var(--brass); padding: 4px 10px; border-radius: 999px; letter-spacing: 0.08em; }
  .spec-mark { font-size: 2.2rem; letter-spacing: 0.04em; color: var(--green-900); padding: 14px 0 12px; border-bottom: 1px solid var(--line); }
  .spec-rows { display: grid; grid-template-columns: 130px 1fr; gap: 8px 12px; padding: 14px 0; font-size: 0.86rem; }
  .spec-rows span:nth-child(odd) { color: var(--muted); }
  .spec-track { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .spec-track i { height: 5px; border-radius: 999px; background: var(--line); }
  .spec-track i.on { background: var(--green-700); }
  .tm-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .tm-steps li { display: grid; grid-template-columns: 64px 1fr; gap: 18px; padding: 26px; border-radius: var(--radius); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); }
  .tm-n { font-size: 2.2rem; line-height: 1; font-style: italic; color: var(--brass-soft); }
  .tm-title { font-family: var(--sans); font-size: 0.8rem; font-weight: 560; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; margin-bottom: 8px; }
  .tm-steps p { color: rgba(232, 240, 236, 0.8); }

  /* Approach */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .steps li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 30px; display: grid; gap: 14px; align-content: start; box-shadow: var(--shadow-sm); }
  .step-n { font-size: 2rem; font-style: italic; color: var(--brass); line-height: 1; }
  .steps .h3 { color: var(--green-900); }
  .steps p { color: var(--ink-2); }

  /* About teaser */
  .at-card { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 80px); align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: clamp(24px, 3vw, 36px); padding: clamp(16px, 2vw, 24px); box-shadow: var(--shadow); }
  .at-copy { display: grid; gap: 22px; padding: clamp(8px, 3vw, 40px) clamp(8px, 3vw, 40px) clamp(8px, 3vw, 40px) 0; }
  .portrait { aspect-ratio: 2 / 3; border-radius: calc(clamp(24px, 3vw, 36px) - 10px); overflow: hidden; background: var(--mint); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .creds { list-style: none; margin: 4px 0; padding: 0; border-top: 1px solid var(--line); }
  .creds li { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
  .creds li span:first-child { font-weight: 540; color: var(--green-900); }
  .creds li span:last-child { color: var(--muted); }

  /* Testimonials */
  .t-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; align-items: stretch; }
  .t-feature { margin: 0; background: var(--brass-wash); border: 1px solid var(--brass-soft); border-radius: var(--radius); padding: clamp(28px, 4vw, 48px); display: grid; gap: 28px; align-content: space-between; }
  .t-feature blockquote { margin: 0; font-size: clamp(1.45rem, 2.3vw, 2rem); line-height: 1.3; color: var(--green-900); letter-spacing: -0.01em; }
  .t-stack { display: grid; gap: 16px; }
  .t-card { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 28px; display: grid; gap: 14px; box-shadow: var(--shadow-sm); }
  .t-card blockquote { margin: 0; font-size: 1.2rem; line-height: 1.35; color: var(--green-900); }
  figcaption { display: grid; gap: 2px; font-size: 0.9rem; }
  figcaption span { color: var(--muted); }
  .t-note { margin-top: 20px; font-size: 0.86rem; color: var(--muted); }
  .t-note a { color: var(--green-700); margin-left: 8px; }

  .posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  /* Contact */
  .c-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
