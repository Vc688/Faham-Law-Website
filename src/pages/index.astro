---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import PostCard from '../components/PostCard.astro';
import { firm, home, settings, practices, industries, testimonials, showTestimonials, practiceBySlug, emph, officeLabels } from '../data/site';
import { getPublishedPosts } from '../lib/posts';
import { davidPerson } from '../lib/schema';

const posts = (await getPublishedPosts()).slice(0, 3);
const gcSlug = home.stages[0]?.slug ?? practices[0].slug;
const gc = practiceBySlug[gcSlug] ?? practices[0];
const otherPractices = practices.filter((p) => p.slug !== gc.slug);
const featuredSlug = 'ip-trademarks';
const [featured, ...moreTestimonials] = testimonials;
const stages = home.stages.filter((s) => practiceBySlug[s.slug]);
---
<Base title={home.seoTitle} description={home.seoDescription} jsonld={[davidPerson]}>
  <!-- HERO -->
  <section class="hero home-hero">
    <div class="container">
      <div class="hero-top">
        <p class="eyebrow">{home.eyebrow}</p>
        <p class="kicker">{home.kicker}</p>
      </div>
      <h1 class="display hero-title" set:html={emph(home.title)} />

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lead">{home.lead}</p>
          <div class="hero-btns">
            <a class="btn" href={home.primaryCta.href}>{home.primaryCta.label} <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={home.secondaryCta.href}>{home.secondaryCta.label}</a>
          </div>
          <p class="licensed"><span class="pill">NY · NJ · PA</span> {firm.licensed}</p>
        </div>

        <nav class="stage-card" aria-label="Find the right practice area">
          <p class="stage-title serif">{home.routerTitle}</p>
          <ol role="list">
            {stages.map((s) => (
              <li>
                <a href={`/${s.slug}`}>
                  <span class="s-need">{s.need}</span>
                  <span class="s-area">{practiceBySlug[s.slug].name}</span>
                  <span class="s-go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  </section>

  <!-- FRACTIONAL GC -->
  <section class="section gc-sec dark" id="fractional-general-counsel">
    <div class="container">
      <div class="gc-head reveal">
        <div class="section-head">
          <p class="eyebrow">{home.gc.eyebrow}</p>
          <h2 class="h2" set:html={emph(home.gc.title)} />
          <p class="lead">{home.gc.lead}</p>
        </div>
      </div>
      <ol class="gc-points" role="list">
        {home.gc.points.map((pt, i) => (
          <li class="reveal">
            <span class="gc-n serif">0{i + 1}</span>
            <div>
              <h3 class="gc-title">{pt.title}</h3>
              <p>{pt.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="gc-foot reveal">
        {gc.who && <p class="gc-who"><span class="kicker">Who it's for</span>{gc.who}</p>}
        <a class="btn btn-brass" href={home.gc.cta.href}>{home.gc.cta.label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- OTHER PRACTICE AREAS -->
  <section class="section practices-sec" id="practice-areas">
    <div class="container">
      <div class="split-head reveal">
        <div class="section-head">
          <p class="eyebrow">{home.practicesEyebrow}</p>
          <h2 class="h2" set:html={emph(home.practicesTitle)} />
        </div>
        <a class="link-arrow" href="/services">All practice areas <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="bento">
        {otherPractices.map((p) => (
          <a href={`/${p.slug}`} class:list={['p-card reveal', { feature: p.slug === featuredSlug }]}>
            <span class="p-num serif">{practices.indexOf(p) + 1}</span>
            <h3 class="p-name serif">{p.name}</h3>
            <p class="p-sum">{p.short}</p>
            <span class="p-foot">
              <span class="link-arrow">Learn more <span class="arrow" aria-hidden="true">→</span></span>
              {p.slug === featuredSlug && <span class="p-extra"><span>{home.trademark.primaryCta.label}</span><span>{home.trademark.secondaryCta.label}</span></span>}
            </span>
          </a>
        ))}
      </div>
      <div class="industries reveal" aria-label={home.industriesLabel}>
        <span class="kicker">{home.industriesLabel}</span>
        <ul role="list">{industries.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- TRADEMARK STRIP -->
  <section class="section-tight tm-strip-sec">
    <div class="container">
      <div class="tm-strip reveal">
        <div class="tm-copy">
          <p class="eyebrow">{home.trademark.eyebrow}</p>
          <h2 class="h2" set:html={emph(home.trademark.title)} />
          <p class="lead">{home.trademark.text}</p>
        </div>
        <div class="tm-btns">
          <a class="btn" href={home.trademark.primaryCta.href}>{home.trademark.primaryCta.label} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={home.trademark.secondaryCta.href}>{home.trademark.secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT DAVID -->
  <section class="section-tight about-teaser">
    <div class="container">
      <div class="at-card reveal">
        <div class="portrait">
          <img src={settings.headshot} alt={settings.headshotAlt} width="1000" height="1500" loading="lazy" decoding="async" />
        </div>
        <div class="at-copy">
          <p class="eyebrow">{home.about.eyebrow}</p>
          <h2 class="h2">{firm.partner}</h2>
          <p class="lead">{home.about.lead}</p>
          <ul class="creds" role="list">
            {home.about.creds.map((c) => <li><span>{c.label}</span><span>{c.value}</span></li>)}
          </ul>
          <a class="link-arrow" href="/about">{home.about.cta} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {showTestimonials && testimonials.length > 0 && (
    <section class="section-tight testi">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{home.testimonialsEyebrow}</p>
          <h2 class="h2" set:html={emph(home.testimonialsTitle)} />
        </div>
        <div class="t-grid">
          <figure class="t-feature reveal">
            <blockquote class="serif">“{featured.quote}”</blockquote>
            <figcaption><strong>{featured.name}</strong><span>{featured.role}</span></figcaption>
          </figure>
          <div class="t-stack">
            {moreTestimonials.map((t) => (
              <figure class="t-card reveal">
                <blockquote class="serif">“{t.quote}”</blockquote>
                <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
        <p class="t-note">Prior results do not guarantee a similar outcome. <a href="/testimonials">All testimonials</a></p>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <div class="split-head reveal">
          <div class="section-head">
            <p class="eyebrow">Insights</p>
            <h2 class="h2">Recent articles</h2>
          </div>
          <a class="link-arrow" href="/insights">All insights <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="posts-grid">
          {posts.map((post) => <div class="reveal"><PostCard post={post} /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section class="section contact-sec" id="contact">
    <div class="container c-grid">
      <div class="c-copy reveal">
        <p class="eyebrow">{home.contact.eyebrow}</p>
        <h2 class="h2" set:html={emph(home.contact.title)} />
        <p class="lead">{home.contact.lead}</p>
        <dl class="c-list">
          <div><dt>Phone</dt><dd><a href={firm.phoneHref}>{firm.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${firm.email}`}>{firm.email}</a></dd></div>
          <div><dt>Offices</dt><dd>{officeLabels.join(' · ')}</dd></div>
        </dl>
      </div>
      <div class="c-form card reveal">
        <ContactForm idPrefix="home" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .home-hero { padding-bottom: clamp(40px, 5vw, 64px); }
  .hero-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 36px); }
  .hero-title { max-width: 13em; font-size: clamp(2.7rem, 7vw, 6.4rem); }
  .hero-grid {
    display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(32px, 6vw, 96px); align-items: start;
    margin-top: clamp(36px, 5vw, 64px); padding-top: clamp(28px, 4vw, 40px); border-top: 1px solid var(--line-strong);
  }
  .hero-copy { display: grid; gap: 26px; }
  .hero-copy .lead { max-width: 520px; font-size: clamp(1.12rem, 1.5vw, 1.32rem); }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .licensed { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 0.9rem; color: var(--muted); }

  .stage-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 10px; }
  .stage-title { font-size: 1.45rem; color: var(--green-900); padding: 16px 18px 12px; }
  .stage-card ol { list-style: none; margin: 0; padding: 0; }
  .stage-card li + li { border-top: 1px solid var(--line); }
  .stage-card a {
    display: grid; grid-template-columns: 1fr auto 28px; align-items: center; gap: 14px;
    padding: 15px 18px; border-radius: 14px; text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .stage-card li:hover + li, .stage-card li:hover { border-color: transparent; }
  .stage-card a:hover { background: var(--green-800); color: #fff; }
  .s-need { font-weight: 480; font-size: 1.02rem; }
  .s-area { font-size: 0.78rem; font-weight: 540; letter-spacing: 0.04em; color: var(--green-700); background: var(--mint); padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
  .stage-card a:hover .s-area { background: rgba(255,255,255,0.14); color: var(--brass-soft); }
  .s-go { color: var(--brass); transition: transform 0.25s var(--ease); }
  .stage-card a:hover .s-go { transform: translateX(3px); color: var(--brass-soft); }

  /* Fractional GC */
  .gc-sec { position: relative; overflow: hidden; isolation: isolate; border-radius: clamp(24px, 3vw, 40px); margin-inline: clamp(8px, 1.4vw, 20px); }
  .gc-sec::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(800px 420px at 100% 0%, rgba(158, 196, 198, 0.18), transparent 65%), radial-gradient(700px 400px at 0% 100%, rgba(168, 131, 74, 0.16), transparent 65%); }
  .gc-head .section-head { max-width: 820px; }
  .gc-points { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .gc-points li { display: grid; grid-template-columns: 56px 1fr; gap: 18px; padding: 26px; border-radius: var(--radius); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); }
  .gc-n { font-size: 2rem; line-height: 1; font-style: italic; color: var(--brass-soft); }
  .gc-title { font-family: var(--serif); font-size: 1.45rem; line-height: 1.15; color: #f4f1e8; margin-bottom: 8px; }
  .gc-points p { color: rgba(232, 240, 236, 0.8); }
  .gc-foot { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; margin-top: clamp(28px, 4vw, 44px); padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.14); }
  .gc-who { display: grid; gap: 8px; max-width: 720px; color: rgba(232, 240, 236, 0.86); font-size: 1.02rem; }
  .gc-who .kicker { color: var(--brass-soft); }

  /* Practice bento */
  .bento { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .p-card {
    display: grid; grid-template-rows: auto auto 1fr auto; gap: 14px;
    padding: clamp(24px, 2.6vw, 34px); min-height: 300px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow-sm); text-decoration: none;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s;
  }
  .p-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--line-strong); }
  .p-card:hover .arrow { transform: translateX(3px); }
  .p-num { font-size: 2.4rem; line-height: 1; font-style: italic; color: var(--brass); }
  .p-name { font-size: clamp(1.7rem, 2.4vw, 2.2rem); line-height: 1.05; color: var(--green-900); letter-spacing: -0.015em; }
  .p-sum { color: var(--muted); font-size: 0.98rem; max-width: 560px; }
  .p-foot { padding-top: 8px; display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; }
  .p-extra { display: flex; flex-wrap: wrap; gap: 8px; }
  .p-extra span { font-size: 0.82rem; font-weight: 540; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,0.1); color: var(--brass-soft); border: 1px solid rgba(255,255,255,0.18); }
  .feature { grid-column: 1 / -1; background: var(--green-800); border-color: transparent; color: #e8f0ec; position: relative; overflow: hidden; isolation: isolate; min-height: 0; }
  .feature::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(70% 90% at 100% 0%, rgba(233, 220, 193, 0.2), transparent 60%); }
  .feature .p-name { color: #f4f1e8; font-size: clamp(2rem, 3.2vw, 2.9rem); }
  .feature .p-sum { color: rgba(232, 240, 236, 0.78); font-size: 1.05rem; }
  .feature .p-num { color: var(--brass-soft); }
  .feature .link-arrow { color: var(--brass-soft); }
  .industries { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 28px; padding: 18px 22px; border: 1px dashed var(--line-strong); border-radius: var(--radius-md); }
  .industries ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .industries li { padding: 6px 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 0.88rem; color: var(--ink-2); }

  /* Trademark strip */
  .tm-strip-sec { padding-top: 0; }
  .tm-strip { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; background: var(--brass-wash); border: 1px solid var(--brass-soft); border-radius: var(--radius); padding: clamp(28px, 4vw, 48px); }
  .tm-copy { display: grid; gap: 14px; }
  .tm-copy .h2 { font-size: clamp(1.8rem, 3.2vw, 2.6rem); }
  .tm-copy .lead { font-size: 1.05rem; }
  .tm-btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }

  /* About teaser */
  .at-card { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 80px); align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: clamp(24px, 3vw, 36px); padding: clamp(16px, 2vw, 24px); box-shadow: var(--shadow); }
  .at-copy { display: grid; gap: 22px; padding: clamp(8px, 3vw, 40px) clamp(8px, 3vw, 40px) clamp(8px, 3vw, 40px) 0; }
  .portrait { aspect-ratio: 2 / 3; border-radius: calc(clamp(24px, 3vw, 36px) - 10px); overflow: hidden; background: var(--mint); }
  .portrait img { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: 50% 30%; }
  .creds { list-style: none; margin: 4px 0; padding: 0; border-top: 1px solid var(--line); }
  .creds li { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
  .creds li span:first-child { font-weight: 540; color: var(--green-900); }
  .creds li span:last-child { color: var(--muted); }

  /* Testimonials */
  .t-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; align-items: stretch; }
  .t-feature { margin: 0; background: var(--brass-wash); border: 1px solid var(--brass-soft); border-radius: var(--radius); padding: clamp(28px, 4vw, 48px); display: grid; gap: 28px; align-content: space-between; }
  .t-feature blockquote { margin: 0; font-size: clamp(1.45rem, 2.3vw, 2rem); line-height: 1.3; color: var(--green-900); letter-spacing: -0.01em; }
  .t-stack { display: grid; gap: 16px; }
  .t-card { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 28px; display: grid; gap: 14px; box-shadow: var(--shadow-sm); }
  .t-card blockquote { margin: 0; font-size: 1.2rem; line-height: 1.35; color: var(--green-900); }
  figcaption { display: grid; gap: 2px; font-size: 0.9rem; }
  figcaption span { color: var(--muted); }
  .t-note { margin-top: 20px; font-size: 0.86rem; color: var(--muted); }
  .t-note a { color: var(--green-700); margin-left: 8px; }

  .posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  /* Contact */
  .c-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .c-copy { display: grid; gap: 22px; position: sticky; top: calc(var(--header-h) + 32px); }
  .c-list { margin: 16px 0 0; border-top: 1px solid var(--line-strong); }
  .c-list > div { display: grid; grid-template-columns: 110px 1fr; padding: 16px 0; border-bottom: 1px solid var(--line-strong); }
  .c-list dt { font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); font-weight: 560; padding-top: 4px; }
  .c-list dd { margin: 0; font-family: var(--serif); font-size: 1.3rem; color: var(--green-900); }
  .c-list a { text-decoration: none; overflow-wrap: anywhere; }
  .c-list a:hover { color: var(--green-700); text-decoration: underline; }

  @media (max-width: 980px) {
    .hero-grid, .at-card, .c-grid, .t-grid, .gc-points, .tm-strip { grid-template-columns: 1fr; }
    .gc-foot { grid-template-columns: 1fr; }
    .tm-btns { justify-content: flex-start; }
    .posts-grid { grid-template-columns: 1fr; }
    .c-copy { position: static; }
    .portrait { max-width: 440px; }
    .at-copy { padding: 8px; }
  }
  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; }
    .p-card { min-height: 0; }
    .creds li { grid-template-columns: 1fr; gap: 2px; }
    .stage-card a { grid-template-columns: 1fr 24px; }
    .s-area { grid-column: 1; grid-row: 2; justify-self: start; }
    .s-go { grid-column: 2; grid-row: 1 / 3; }
    .gc-points li { grid-template-columns: 1fr; gap: 10px; }
    .gc-sec { margin-inline: 0; border-radius: 24px; }
  }
</style>
