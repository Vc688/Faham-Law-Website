---
import Base from '../layouts/Base.astro';
import { firm } from '../data/site';
---
<Base title="Thank you | Faham Law LLC" description="Your message has been sent." noindex>
  <section class="hero ty">
    <div class="container narrow inner">
      <div class="check" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></div>
      <h1 class="display">Thank you.</h1>
      <p class="lead">We've received your submission and will be in touch shortly. If your matter is time-sensitive, call us at <a href={firm.phoneHref}>{firm.phone}</a>.</p>
      <div class="btns"><a class="btn btn-light" href="/">Back to home</a><a class="btn btn-ghost" style="color:#fff" href="/services">Practice areas</a></div>
    </div>
  </section>
</Base>
<style>
  .ty { min-height: 78vh; display: grid; align-items: center; }
  .inner { display: grid; gap: 24px; }
  .check { width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; background: var(--brass); color: var(--green-950); }
  .lead a { color: #fff; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
