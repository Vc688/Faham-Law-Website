---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Faham Law LLC" description="The page you're looking for doesn't exist." noindex>
  <section class="hero nf">
    <div class="container narrow inner">
      <p class="eyebrow">Error 404</p>
      <h1 class="display">Page not found</h1>
      <p class="lead">Try one of these instead.</p>
      <div class="btns"><a class="btn" href="/">Home</a><a class="btn btn-ghost" href="/services">Practice areas</a><a class="btn btn-ghost" href="/contact">Contact</a></div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 78vh; display: grid; align-items: center; }
  .inner { display: grid; gap: 24px; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
