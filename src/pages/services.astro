---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { practices } from '../data/site';
import { breadcrumbs } from '../lib/schema';
---
<Base
  title="Practice Areas: Business, Real Estate, M&A & Trademark Law"
  description="Entity formation, outside corporate counsel, mergers and acquisitions, real estate closings and leases, and trademark services for businesses in NY, NJ and PA."
  jsonld={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Practice Areas', path: '/services' }])]}
>
  <PageHero
    eyebrow="What we do"
    title="Practice Areas"
    lead="Legal services for privately held businesses, from the day you form your company to the day you sell it. Choose an area below, or contact us if you're not sure where your question fits."
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Practice Areas' }]}
  />
  <section class="section-tight">
    <div class="container grid">
      {practices.map((p, i) => (
        <a class:list={['tile reveal', { wide: i === 0 }]} href={`/${p.slug}`}>
          <span class="t-num">0{i + 1}</span>
          <h2 class="t-name serif">{p.name}</h2>
          <p class="t-sum">{p.short}</p>
          <span class="link-arrow">Learn more <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
      <a class="tile tile-dark reveal" href="/contact">
        <span class="t-num">?</span>
        <h2 class="t-name serif">Not sure where your question fits?</h2>
        <p class="t-sum">Tell us what's going on and we'll point you in the right direction.</p>
        <span class="link-arrow">Contact us <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .tile { display: grid; gap: 18px; align-content: start; grid-template-rows: auto auto 1fr auto; padding: 34px; min-height: 340px; background: var(--white); border: 1px solid var(--line); border-radius: 22px; text-decoration: none; transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s; }
  .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--green-300); }
  .tile:hover .arrow { transform: translateX(3px); }
  .wide { grid-column: span 2; background: linear-gradient(135deg, var(--white), var(--mint)); }
  .t-num { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; color: var(--green-700); }
  .t-name { font-size: clamp(2rem, 3vw, 2.6rem); line-height: 1.02; }
  .t-sum { color: var(--muted); }
  .tile-dark { background: var(--green-800); color: #fff; border-color: transparent; }
  .tile-dark .t-sum { color: rgba(255,255,255,0.72); }
  .tile-dark .t-num, .tile-dark .link-arrow { color: var(--brass-soft); }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .wide { grid-column: auto; } .tile { min-height: 0; } }
</style>
