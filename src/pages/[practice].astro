---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import PostCard from '../components/PostCard.astro';
import { practices, emph, type Practice } from '../data/site';
import { breadcrumbs, faqPage } from '../lib/schema';
import { getPublishedPosts } from '../lib/posts';

export function getStaticPaths() {
  return practices.map((p) => ({ params: { practice: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Practice };
const idx = practices.findIndex((x) => x.slug === p.slug);
const related = (await getPublishedPosts()).filter((post) => post.data.category === p.slug).slice(0, 3);
const toc = [
  ...p.groups.map((g) => ({ id: g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-'), label: g.title })),
  ...(p.who ? [{ id: 'who-we-work-with', label: 'Who we work with' }] : []),
  { id: 'common-questions', label: 'Common questions' },
  ...(related.length ? [{ id: 'insights', label: 'Insights' }] : []),
];
const others = practices.filter((x) => x.slug !== p.slug);
---
<Base
  title={p.seoTitle}
  description={p.seoDescription}
  jsonld={[
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Practice Areas', path: '/services' }, { name: p.name, path: `/${p.slug}` }]),
    faqPage(p.faqs),
  ]}
>
  <PageHero
    eyebrow={`Practice area ${idx + 1} of ${practices.length}`}
    title={emph(p.h1)}
    lead={p.intro}
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Practice Areas', href: '/services' }, { name: p.name }]}
    compact
  >
    <div class="hero-btns">
      <a class="btn" href="/contact">Book a consultation <span class="arrow" aria-hidden="true">→</span></a>
      {p.ctaSecondary && <a class="btn btn-ghost" href={p.ctaSecondary.href}>{p.ctaSecondary.label}</a>}
    </div>
  </PageHero>

  <div class="container layout section-tight">
    <aside class="toc" aria-label="On this page">
      <div class="toc-card">
        <p class="kicker">On this page</p>
        <ul role="list">
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
        </ul>
      </div>
      <div class="ask">
        <p class="serif">Have a question about {p.name}?</p>
        <a class="link-arrow" href="/contact">Contact us <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </aside>

    <div class="content">
      {p.groups.map((g) => (
        <section class="block" id={g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
          <h2 class="h2 reveal">{g.title}</h2>
          {g.note && <p class="lead reveal">{g.note}</p>}
          <ul role="list" class="items reveal">
            {g.items.map((it) => (
              <li class:list={['item', { solo: !it.label }]}>
                {it.label && <h3 class="item-label serif">{it.label}</h3>}
                <p>{it.text}</p>
              </li>
            ))}
          </ul>
          {p.slug === 'ip-trademarks' && g.title === 'Trademarks' && (
            <div class="tm-ctas reveal">
              <a class="tm-cta" href="/file-a-trademark">
                <span><strong>Ready to file?</strong> Start with our File a Trademark form.</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
              <a class="tm-cta tm-cta-light" href="/fees">
                <span><strong>Flat fees.</strong> See the trademark and copyright fee schedule.</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          )}
        </section>
      ))}

      {p.who && (
        <section class="block" id="who-we-work-with">
          <h2 class="h2 reveal">Who we work with</h2>
          <p class="who serif reveal">{p.who}</p>
        </section>
      )}

      <section class="block" id="common-questions">
        <h2 class="h2 reveal">Common questions</h2>
        <div class="reveal"><Faq faqs={p.faqs} /></div>
        <p class="faq-note">General information only, not legal advice for your situation.</p>
      </section>

      {related.length > 0 && (
        <section class="block" id="insights">
          <h2 class="h2">Insights</h2>
          <div class="rel-grid">{related.map((post) => <PostCard post={post} />)}</div>
        </section>
      )}
    </div>
  </div>

  <CtaBand title={p.cta} text="Tell us about your matter and we'll call you back to schedule a consultation." secondary={p.ctaSecondary} />

  <section class="section-tight others">
    <div class="container">
      <p class="eyebrow">Other practice areas</p>
      <ul role="list" class="o-list">
        {others.map((o) => (
          <li>
            <a href={`/${o.slug}`}>
              <span class="o-num serif">{practices.indexOf(o) + 1}</span>
              <span class="o-name serif">{o.name}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .layout { display: grid; grid-template-columns: 270px 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .toc { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 14px; }
  .toc-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 20px 20px 14px; box-shadow: var(--shadow-sm); display: grid; gap: 10px; }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li a { display: block; padding: 8px 12px; margin-inline: -12px; border-radius: 10px; text-decoration: none; color: var(--ink-2); font-size: 0.96rem; }
  .toc li a:hover { color: var(--green-800); background: var(--mint-2); }
  .ask { padding: 20px; border-radius: var(--radius-md); background: var(--brass-wash); display: grid; gap: 12px; }
  .ask p { font-size: 1.25rem; line-height: 1.25; color: var(--green-900); }

  .content { display: grid; gap: clamp(64px, 8vw, 104px); min-width: 0; }
  .block { display: grid; gap: 26px; }
  .items { list-style: none; margin: 0; padding: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }
  .item { display: grid; grid-template-columns: minmax(170px, 0.8fr) 1.6fr; gap: 12px 32px; padding: 24px 28px; }
  .item + .item { border-top: 1px solid var(--line); }
  .item.solo { grid-template-columns: 1fr; padding-left: 52px; position: relative; }
  .item.solo::before { content: ''; position: absolute; left: 28px; top: 34px; width: 8px; height: 8px; border-radius: 50%; background: var(--brass); }
  .item-label { font-size: 1.3rem; line-height: 1.2; color: var(--green-900); }
  .item p { color: var(--ink-2); }
  .who { font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.35; color: var(--green-900); padding-left: 24px; border-left: 2px solid var(--brass); }
  .faq-note { font-size: 0.85rem; color: var(--muted); }
  .tm-ctas { display: grid; gap: 10px; }
  .tm-cta-light { background: var(--brass-wash) !important; color: var(--green-900) !important; box-shadow: var(--shadow-sm) !important; }
  .tm-cta-light strong { color: var(--brass) !important; }
  .tm-cta { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 26px; border-radius: var(--radius-md); background: var(--green-800); color: #fff; text-decoration: none; box-shadow: var(--shadow); }
  .tm-cta strong { color: var(--brass-soft); font-weight: 560; }
  .tm-cta:hover .arrow { transform: translateX(4px); }
  .tm-cta .arrow { transition: transform 0.25s var(--ease); font-size: 1.2rem; }
  .rel-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

  .others { padding-top: 0; }
  .o-list { list-style: none; margin: 22px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .o-list a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 20px 22px; border: 1px solid var(--line); border-radius: var(--radius-md); text-decoration: none; background: var(--surface); height: 100%; box-shadow: var(--shadow-sm); transition: background 0.25s, color 0.25s, transform 0.25s var(--ease); }
  .o-list a:hover { background: var(--green-800); color: #fff; transform: translateY(-2px); }
  .o-num { font-style: italic; color: var(--brass); font-size: 1.4rem; }
  .o-list a:hover .o-num { color: var(--brass-soft); }
  .o-name { font-size: 1.25rem; line-height: 1.15; }

  @media (max-width: 980px) {
    .layout { grid-template-columns: 1fr; }
    .toc { position: static; }
    .toc { display: none; }
    .rel-grid { grid-template-columns: 1fr; }
    .o-list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .item { grid-template-columns: 1fr; gap: 6px; padding: 20px; }
    .item.solo { padding-left: 40px; }
    .item.solo::before { left: 20px; top: 30px; }
    .o-list { grid-template-columns: 1fr; }
  }
</style>
