---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { testimonials, showTestimonials, home, emph } from '../data/site';
import { breadcrumbs } from '../lib/schema';
if (!showTestimonials) return Astro.redirect('/about');
---
<Base
  title="Client Testimonials"
  description="What business owners say about working with David Faham and Faham Law LLC."
  jsonld={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Testimonials', path: '/testimonials' }])]}
>
  <PageHero eyebrow={home.testimonialsEyebrow} title={emph(home.testimonialsTitle)} crumbs={[{ name: 'Home', href: '/' }, { name: 'Testimonials' }]} compact />
  <section class="section-tight">
    <div class="container">
      <div class="masonry">
        {testimonials.map((t, i) => (
          <figure class:list={['t reveal', { feature: i === 0 }]}>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="note">Prior results do not guarantee a similar outcome.</p>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .masonry { columns: 2; column-gap: 20px; }
  .t { break-inside: avoid; margin: 0 0 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 34px; display: grid; gap: 22px; box-shadow: var(--shadow-sm); }
  .t blockquote { margin: 0; font-family: var(--serif); font-size: 1.5rem; line-height: 1.32; color: var(--green-900); }
  .feature { background: var(--brass-wash); border-color: var(--brass-soft); }
  .feature blockquote { font-size: 1.8rem; }
  .t figcaption { display: grid; gap: 2px; }
  .t figcaption span { color: var(--muted); font-size: 0.92rem; }
  .note { font-size: 0.88rem; color: var(--muted); margin-top: 8px; }
  @media (max-width: 800px) { .masonry { columns: 1; } }
</style>
